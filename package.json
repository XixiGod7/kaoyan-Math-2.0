{
  "name": "kaoyan-math-2.0",
  "version": "1.0.0",
  "description": "考研数学真题研习平台，支持本地运行与 Cloudflare Workers 部署",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prepare:data": "node scripts/prepare-politics.cjs",
    "pretest": "npm run build:ui",
    "test": "node --test test/*.test.js",
    "dev:cloudflare": "wrangler dev",
    "build:ui": "npm run prepare:data && tsc -p apps/politics/tsconfig.json && vite build --config apps/politics/vite.config.mts",
    "build": "npm run build:ui && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf:types": "wrangler types"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
